# ============================================================
# LexiRAG Environment Configuration
# ============================================================

# Google Gemini API Key (100% Free via Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection (Google Gemini)
DEFAULT_MODEL=gemini-1.5-flash
FALLBACK_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=models/text-embedding-004
TEMPERATURE=0.0
MAX_TOKENS=1500

# Optional: Legacy OpenAI API Key (if using OpenAI instead of Gemini)
OPENAI_API_KEY=

# RAG & Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=4

# Persistence Paths
VECTOR_STORE_PATH=./data/chroma_db
PDF_DIRECTORY=./data/contracts

# Server Settings
HOST=0.0.0.0
PORT=8000
