# ============================================================
# LexiRAG Environment Configuration
# ============================================================

# OpenAI API Key (Required for GPT-4 / text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
DEFAULT_MODEL=gpt-4-turbo
FALLBACK_MODEL=gpt-3.5-turbo
TEMPERATURE=0.0
MAX_TOKENS=1500

# RAG & Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=4

# Persistence Paths
VECTOR_STORE_PATH=./data/chroma_db
PDF_DIRECTORY=./data/contracts

# Server Settings
HOST=0.0.0.0
PORT=8000
